generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  CURATOR
  OPERATIONS
  PARTNER
  CUSTOMER
  NAZHIR_VIEWER
}

enum ProductStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUIRED
  APPROVED
  READY_TO_PUBLISH
  ACTIVE
  SUSPENDED
  ARCHIVED
  INACTIVE
  REJECTED
}

enum LegalDocumentType {
  BUSINESS_LICENSE
  IDENTITY
  FOOD_SAFETY
  OTHER
}

enum LegalDocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUIRED
  APPROVED
  READY_TO_PUBLISH
  ACTIVE
  SUSPENDED
  ARCHIVED
  REJECTED
}

enum SubmissionPhotoType {
  INITIAL
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  PRODUCTION
  QC
  READY
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ProductionStatus {
  UNASSIGNED
  ASSIGNED
  IN_PRODUCTION
  QC
  READY
}

enum FinanceAccrualStatus {
  AVAILABLE
  RESERVED
  PAID
}

enum PayoutStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model User {
  id                  String                 @id @default(cuid())
  email               String                 @unique
  name                String
  passwordHash        String
  role                Role
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  partner             Partner?
  submissionRevisions SubmissionRevision[]
  submissionScores    SubmissionScore[]
  curatorNotes        CuratorNote[]
  submissionDecisions SubmissionDecision[]
  finalizedProducts   ProductFinalization[]
  publishedProducts   ProductPublication[]
  auditLogs           AuditLog[]
  statusHistory       OrderStatusHistory[]
  createdPayouts      Payout[]
}

model Category {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  createdAt   DateTime            @default(now())
  products    Product[]
  submissions ProductSubmission[]
  finalizations ProductFinalization[]
}

enum PartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Partner {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  description    String
  websiteUrl     String?
  userId         String?          @unique
  phone          String?
  address        String?
  status         PartnerStatus    @default(PENDING)
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  profile        PartnerProfile?
  legalDocuments LegalDocument[]
  submissions    ProductSubmission[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  products       Product[]
  publications   ProductPublication[]
  assignedOrderItems OrderItem[]
  financeAccruals FinanceAccrual[]
  payouts        Payout[]
}

model PartnerProfile {
  id          String   @id @default(cuid())
  partnerId   String   @unique
  contactName String
  phone       String
  address     String
  city        String
  province    String
  postalCode  String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

model LegalDocument {
  id           String              @id @default(cuid())
  partnerId    String
  type         LegalDocumentType
  status       LegalDocumentStatus @default(PENDING)
  originalName String
  objectKey    String              @unique
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  partner      Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt])
}

model ProductSubmission {
  id             String            @id @default(cuid())
  partnerId      String
  name           String
  description    String
  categoryId     String
  hppRupiah      Int?
  capacityAmount Int?
  capacityUnit   String?
  capacityPeriod String?
  status         SubmissionStatus  @default(DRAFT)
  submittedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  partner        Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  category       Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  photos         SubmissionPhoto[]
  revisions      SubmissionRevision[]
  scores         SubmissionScore[]
  notes          CuratorNote[]
  decisions      SubmissionDecision[]
  finalization   ProductFinalization?
  publication    ProductPublication?
  auditLogs      AuditLog[]

  @@index([partnerId, status, updatedAt])
  @@index([status, updatedAt])
}

model SubmissionPhoto {
  id           String              @id @default(cuid())
  submissionId String
  type         SubmissionPhotoType @default(INITIAL)
  originalName String
  objectKey    String              @unique
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime            @default(now())
  submission   ProductSubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
}

model SubmissionRevision {
  id           String            @id @default(cuid())
  submissionId String
  actorUserId  String
  fromStatus   SubmissionStatus
  toStatus     SubmissionStatus
  note         String?
  createdAt    DateTime          @default(now())
  submission   ProductSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actor        User              @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([submissionId, createdAt])
}

model SubmissionScore {
  id                    String            @id @default(cuid())
  submissionId          String
  curatorUserId         String
  productFeasibility    Int
  qualityConsistency    Int
  legality              Int
  productionCapacity    Int
  pricingHpp            Int
  packagingBranding     Int
  marketReadiness       Int
  subtotal              Int
  total                 Int
  completionPercent     Int
  decisionThreshold     Int
  status                String            @default("PENDING")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  submission            ProductSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  curator               User              @relation(fields: [curatorUserId], references: [id], onDelete: Restrict)

  @@unique([submissionId, curatorUserId])
  @@index([submissionId, createdAt])
}

model CuratorNote {
  id             String            @id @default(cuid())
  submissionId   String
  actorUserId    String
  note           String
  reason         String?
  partnerVisible Boolean           @default(false)
  createdAt      DateTime          @default(now())
  submission     ProductSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actor          User              @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([submissionId, createdAt])
}

model SubmissionDecision {
  id           String            @id @default(cuid())
  submissionId String
  actorUserId  String
  fromStatus   SubmissionStatus
  toStatus     SubmissionStatus
  decision     String
  reason       String?
  createdAt    DateTime          @default(now())
  submission   ProductSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actor        User              @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([submissionId, createdAt])
}

model ProductFinalization {
  id             String            @id @default(cuid())
  submissionId   String            @unique
  approvedByUserId String
  finalName      String
  slug           String           @unique
  description    String
  categoryId     String
  price          Int
  imageUrl       String
  partnerInfo    String?
  metadata       String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  submission     ProductSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  approver       User              @relation(fields: [approvedByUserId], references: [id], onDelete: Restrict)
  category       Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([slug])
}

model ProductPublication {
  id             String            @id @default(cuid())
  submissionId   String            @unique
  productId      String            @unique
  partnerId      String
  publishedByUserId String
  status         ProductStatus     @default(ACTIVE)
  publishedAt    DateTime          @default(now())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  submission     ProductSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  partner        Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  publisher      User              @relation(fields: [publishedByUserId], references: [id], onDelete: Restrict)

  @@index([status, publishedAt])
}

model AuditLog {
  id           String            @id @default(cuid())
  actorUserId  String?
  entityType   String
  entityId     String
  action       String
  details      String?
  createdAt    DateTime          @default(now())
  submissionId String?
  submission   ProductSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  actor        User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}

model Product {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  price       Int
  description String
  imageUrl    String
  status      ProductStatus        @default(DRAFT)
  categoryId  String
  partnerId   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  category    Category             @relation(fields: [categoryId], references: [id])
  partner     Partner?             @relation(fields: [partnerId], references: [id])
  publication ProductPublication?
  orderItems  OrderItem[]

  @@index([status, categoryId])
}

model Order {
  id                 String              @id @default(cuid())
  orderNumber        String              @unique
  idempotencyKey     String              @unique
  status             OrderStatus         @default(PENDING_PAYMENT)
  paymentStatus      PaymentStatus       @default(PENDING)
  customerName       String
  customerEmail      String
  customerPhone      String
  shippingAddress    String
  shippingCity       String
  shippingProvince   String
  shippingPostalCode String
  subtotalRupiah     Int
  shippingRupiah     Int
  totalRupiah        Int
  paymentReference   String?             @unique
  paidAt             DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  financeAccruals    FinanceAccrual[]

  @@index([status, createdAt])
  @@index([customerEmail, createdAt])
}

model OrderItem {
  id                  String            @id @default(cuid())
  orderId             String
  productId           String?
  productNameSnapshot String
  productSlugSnapshot String
  unitPriceRupiah     Int
  quantity            Int
  lineTotalRupiah     Int
  partnerId           String?
  productionStatus    ProductionStatus  @default(UNASSIGNED)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  order               Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  partner             Partner?          @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  financeAccrual      FinanceAccrual?

  @@index([partnerId, productionStatus, updatedAt])
  @@index([orderId])
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  actorUserId String?
  note        String?
  createdAt   DateTime    @default(now())
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor       User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model FinanceSetting {
  id               String   @id
  producerShareBps Int      @default(8000)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model FinanceAccrual {
  id           String               @id @default(cuid())
  orderItemId  String               @unique
  orderId      String
  partnerId    String
  amountRupiah Int
  status       FinanceAccrualStatus @default(AVAILABLE)
  payoutId     String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  orderItem    OrderItem            @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  order        Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  partner      Partner              @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  payout       Payout?              @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  @@index([partnerId, status])
  @@index([status, createdAt])
  @@index([orderId])
}

model Payout {
  id              String       @id @default(cuid())
  reference       String       @unique
  idempotencyKey  String       @unique
  partnerId       String
  amountRupiah    Int
  status          PayoutStatus @default(PENDING)
  note            String?
  createdByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  completedAt     DateTime?
  cancelledAt     DateTime?
  partner         Partner      @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  creator         User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  accruals        FinanceAccrual[]

  @@index([partnerId, status, createdAt])
  @@index([status, createdAt])
}
