generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  CURATOR
  OPERATIONS
  PARTNER
  CUSTOMER
  NAZHIR_VIEWER
}

enum ProductStatus {
  DRAFT
  REVIEW
  ACTIVE
  INACTIVE
}

enum LegalDocumentType {
  BUSINESS_LICENSE
  IDENTITY
  FOOD_SAFETY
  OTHER
}

enum LegalDocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  REVISION_REQUIRED
  APPROVED
  REJECTED
}

enum SubmissionPhotoType {
  INITIAL
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  partner      Partner?
  submissionRevisions SubmissionRevision[]
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
  submissions ProductSubmission[]
}

model Partner {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  websiteUrl  String?
  userId      String?   @unique
  phone       String?
  address     String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  profile     PartnerProfile?
  legalDocuments LegalDocument[]
  submissions ProductSubmission[]
  createdAt   DateTime  @default(now())
  products    Product[]
}

model PartnerProfile {
  id          String   @id @default(cuid())
  partnerId   String   @unique
  contactName String
  phone       String
  address     String
  city        String
  province    String
  postalCode  String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

model LegalDocument {
  id           String              @id @default(cuid())
  partnerId    String
  type         LegalDocumentType
  status       LegalDocumentStatus @default(PENDING)
  originalName String
  objectKey    String              @unique
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  partner      Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt])
}

model ProductSubmission {
  id             String           @id @default(cuid())
  partnerId      String
  name           String
  description    String
  categoryId     String
  hppRupiah      Int?
  capacityAmount Int?
  capacityUnit   String?
  capacityPeriod String?
  status         SubmissionStatus @default(DRAFT)
  submittedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  partner         Partner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  photos          SubmissionPhoto[]
  revisions       SubmissionRevision[]

  @@index([partnerId, status, updatedAt])
}

model SubmissionPhoto {
  id           String              @id @default(cuid())
  submissionId String
  type         SubmissionPhotoType @default(INITIAL)
  originalName String
  objectKey    String              @unique
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime            @default(now())
  submission   ProductSubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
}

model SubmissionRevision {
  id           String           @id @default(cuid())
  submissionId String
  actorUserId  String
  fromStatus   SubmissionStatus
  toStatus     SubmissionStatus
  note         String?
  createdAt    DateTime         @default(now())
  submission   ProductSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actor        User             @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([submissionId, createdAt])
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  price       Int
  description String
  imageUrl    String
  status      ProductStatus @default(DRAFT)
  categoryId  String
  partnerId   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  category    Category      @relation(fields: [categoryId], references: [id])
  partner     Partner?      @relation(fields: [partnerId], references: [id])

  @@index([status, categoryId])
}
