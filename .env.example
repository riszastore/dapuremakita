DATABASE_URL=postgresql://dapuremakita:dapuremakita@localhost:5432/dapuremakita?schema=public
JWT_SECRET=replace-with-a-long-local-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
PORT=3000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
UPLOAD_DIR=./var/uploads
# 0 for direct/local access; usually 1 only when exactly one trusted reverse proxy is in front.
TRUST_PROXY=0
SHUTDOWN_TIMEOUT_MS=10000
# Optional for production web deployments; leave empty when using Vite dev proxy.
VITE_API_URL=
# Used by ops/backup.sh. Keep backups outside the web root in production.
BACKUP_DIR=./var/backups
