{
  "name": "dapuremakita",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "npm run dev --workspace @dapuremakita/api & npm run dev --workspace @dapuremakita/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace @dapuremakita/api",
    "audit": "npm audit --audit-level=high"
  },
  "engines": { "node": ">=20" }
}
